{
  "name": "mdcard",
  "version": "1.1.0",
  "type": "module",
  "description": "Markdown to beautiful card images with glassmorphism design",
  "author": "rouguangruye",
  "license": "MIT",
  "homepage": "https://mdcard.rouguang.top/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rouguangruye/MDCard.git"
  },
  "bugs": {
    "url": "https://github.com/rouguangruye/MDCard/issues"
  },
  "keywords": [
    "markdown",
    "card",
    "image",
    "glassmorphism",
    "html2canvas",
    "converter"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.60.0",
    "eslint": "^10.0.0",
    "globals": "^15.12.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.5",
    "prettier": "^3.4.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dom-to-image-more": "^3.7.2",
    "jszip": "^3.10.1"
  }
}
